# Server-only. Leave blank until a destination exists.
# Production inquiries are not stored unless INQUIRY_WEBHOOK_URL is a valid https URL.

INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
INQUIRY_LOG_SINK=

# Optional. Emitted as verification meta tags only when a real value is present at build time.
# These are not secret, but they are omitted until Search Console or Bing provides them.

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
