# Server-only. Names only. Do not put real values in this file.
# Production inquiries are stored only after the receiver confirms a database row.

# Sending side. Production HTTPS endpoint that receives the project inquiry JSON.
# This deployment uses https://www.systemarchq.com/api/inquiries/webhook
# http URLs are rejected. Only a 2xx response is treated as received.
INQUIRY_WEBHOOK_URL=

# Sending side. Bearer token sent only from the server as Authorization.
# Use the same secret value as INQUIRY_RECEIVER_SECRET. Never expose it to the browser.
INQUIRY_WEBHOOK_SECRET=

# Development-only diagnostic sink. Set to true to log an inquiry id without the answers.
# Ignored when NODE_ENV is production. Leave unset in production.
INQUIRY_LOG_SINK=

# Receiving side. Required bearer token for POST /api/inquiries/webhook.
# Same shared value as INQUIRY_WEBHOOK_SECRET in this deployment. Server-only.
INQUIRY_RECEIVER_SECRET=

# Supabase server configuration. Do not prefix these with NEXT_PUBLIC_.
# There is no browser Supabase client.
# SUPABASE_URL is the project URL, for example https://<project-ref>.supabase.co
SUPABASE_URL=

# Privileged secret key (sb_secret_...). Bypasses row level security.
# Server-only. Never place this value in client code or a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Optional. Emitted as verification meta tags only when a real value is present at build time.
# These are not secret, but they are omitted until Search Console or Bing provides them.

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
