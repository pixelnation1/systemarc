# Server-only. Names only. Do not put real values in this file.
# Production inquiries are not stored unless INQUIRY_WEBHOOK_URL is a valid https URL.

# Production HTTPS endpoint that receives the project inquiry JSON.
# http URLs are rejected. Only a 2xx response is treated as received.
INQUIRY_WEBHOOK_URL=

# Optional bearer token shared with that endpoint.
# Sent only from the server as Authorization. Never expose it to the browser.
INQUIRY_WEBHOOK_SECRET=

# Development-only diagnostic sink. Set to true to log an inquiry id without the answers.
# Ignored when NODE_ENV is production. Leave unset in production.
INQUIRY_LOG_SINK=

# Optional. Emitted as verification meta tags only when a real value is present at build time.
# These are not secret, but they are omitted until Search Console or Bing provides them.

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
